istics.json\\nmhd_llm/codex/results/density_low/metadata.json\\nmhd_llm/codex/results/coarse/metadata.json\\nmhd_llm/codex/results/coarse/statistics.json\\nmhd_llm/codex/results/density_low/statistics.json\\nmhd_llm/codex/results/medium/metadata.json\\nmhd_llm/codex/results/medium/statistics.json\\nmhd_llm/codex/results/time_half/metadata.json\\nmhd_llm/codex/results/wide_coarse/metadata.json\\nmhd_llm/codex/results/wide_coarse/statistics.json\\nmhd_llm/codex/solver/tests/cold_radial_48/metadata.json\\nmhd_llm/codex/results/adiabatic/metadata.json\\nmhd_llm/codex/results/adiabatic/statistics.json\\nmhd_llm/codex/solver/tests/cold_radial_48/statistics.json\\nmhd_llm/codex/results/early_start/statistics.json\\nmhd_llm/codex/results/early_start/metadata.json\\nmhd_llm/codex/results/density_high/statistics.json\\nmhd_llm/codex/results/density_high/metadata.json\\nmhd_llm/codex/results/domain45/metadata.json\\nmhd_llm/codex/results/domain45/statistics.json\\nmhd_llm/codex/results/hydro/metadata.json\\nmhd_llm/codex/results/hydro/statistics.json\\nmhd_llm/codex/results/interrupted_wide_medium/metadata.json\\nmhd_llm/codex/solver/tests/cold_radial_24/metadata.json\\nmhd_llm/codex/solver/tests/cold_radial_24/statistics.json\\n\"}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"73a1c1\",\"wall_time_seconds\":0.000009328,\"exit_code\":0,\"original_token_count\":5810,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Create a browsable, source-linked scientific record from actual outputs.\\\"\\\"\\\"\\nfrom pathlib import Path\\nfrom datetime import datetime, timezone\\nimport csv, html, json, re, time\\nimport numpy as np\\n\\nROOT=Path(__file__).resolve().parents[1]\\n\\ndef load(path,default=None):\\n    p=ROOT/path\\n    return json.loads(p.read_text()) if p.exists() else default\\n\\ndef esc(x): return html.escape(str(x))\\ndef f(x,n=3): return f'{x:.{n}g}'\\ndef table(headers,rows):\\n    return '<table><thead><tr>'+''.join('<th>'+esc(x)+'</th>' for x in headers)+'</tr></thead><tbody>'+''.join('<tr>'+''.join('<td>'+esc(x)+'</td>' for x in row)+'</tr>' for row in rows)+'</tbody></table>'\\n\\ndef main():\\n    s=load('results/summary.json');m=load('inputs/metadata.json');best=s['reference_case'];v=s['cases'][best]['PN_GTI_weighted_mean']\\n    numerical=s['numerical_comparisons']; tests=load('solver/tests/verification.json')\\n    manuscript=load('validation/manuscript_benchmark.json',{})\\n    resources=[]; cpu_total=0; wall_total=0; peak=0\\n    for p in sorted((ROOT/'results').iterdir()):\\n        usage=load(f'results/{p.name}/runner_usage.json')\\n        st=load(f'results/{p.name}/statistics.json')\\n        if not usage or not st:continue\\n        text=(p/'resource_usage.txt').read_text()\\n        def number(label):\\n            match=re.search(re.escape(label)+r':\\\\s*([\\\\d.]+)',text)\\n            return float(match.group(1)) if match else 0\\n        cpu=number('User time (seconds)')+number('System time (seconds)');rss=number('Maximum resident set size (kbytes)')/1024\\n        cpu_total+=cpu;wall_total+=usage['wall_seconds_including_inputs'];peak=max(peak,rss)\\n        resources.append([p.name,f'{usage[\\\"wall_seconds_including_inputs\\\"]:.1f}',f'{cpu:.1f}',f'{rss:.1f}',st['steps'],st.get('first_order_fallback_steps',0),f(st.get('weighted_dimensionless_divB',float('nan')))])\\n    start=load('monitoring/start.json');elapsed=time.time()-start['started_unix']\\n    tokenlines=(ROOT/'monitoring/token_snapshots.jsonl').read_text().splitlines() if (ROOT/'monitoring/token_snapshots.jsonl').exists() else []\\n    token= json.loads(tokenlines[-1])['reported_goal_usage']['goal']['tokensUsed'] if tokenlines else None\\n    resource_summary={'created_utc':datetime.now(timezone.utc).isoformat(),'elapsed_project_seconds':elapsed,\\n        'completed_production_and_control_cpu_seconds':cpu_total,'sum_completed_run_wall_seconds_including_inputs':wall_total,\\n        'largest_run_peak_RSS_MB':peak,'reported_goal_tokens_latest':token,\\n        'counting_limits':'CPU sum covers completed results/ runs only; experimental/test CPU and interrupted runs have separate logs. Goal-token counter is tool-reported, not a billing audit. Concurrent wall times must not be summed to estimate elapsed time.'}\\n    (ROOT/'monitoring/summary.json').write_text(json.dumps(resource_summary,indent=2)+'\\\\n')\\n    rows=[]\\n    for name,c in s['cases'].items():\\n        a=c['PN_GTI_weighted_mean'];rows.append([name,f(a['n']),f(a['v']),f(a['v_rel']),f(a['f']/1e7),f(a['f_incident']/1e7)])\\n    comparisonrows=[]\\n    for name,c in numerical.items():\\n        comparisonrows.append([name]+[f'{100*c[k][\\\"maximum_relative_difference\\\"]:.2f}%' for k in ['n','v','f']])\\n    physicalrows=[]\\n    for name,c in s['parameter_comparisons'].items():\\n        physicalrows.append([name]+[f'{100*c[k][\\\"maximum_relative_difference\\\"]:.2f}%' for k in ['n','v','f']])\\n    statuses=f'±30° grid test: {s[\\\"spatial_thresholds_passed\\\"]}; ±60° grid test: {s[\\\"wide_spatial_thresholds_passed\\\"]}; timestep test: {s[\\\"temporal_threshold_passed\\\"]}'\\n    # This status deliberately separates test completion from scientific proof.\\n    stage='Conditional research reconstruction; assess the convergence tests and empirical residuals below.'\\n    css='body{font:17px/1.55 system-ui,sans-serif;color:#1a2940;background:#f7f9fc;max-width:1120px;margin:35px auto;padding:0 22px}h1{font-size:32px}h2{margin-top:2em}a{color:#145d9e}img,video{max-width:100%;border-radius:8px}table{border-collapse:collapse;width:100%;font-size:14px;background:white;display:block;overflow:auto}th,td{text-align:left;padding:8px 12px;border-bottom:1px solid #dde4ef}th{background:#e8eff8}pre{white-space:pre-wrap;font-size:13px;background:#edf2f8;padding:15px}.lead{background:#e7effa;border-left:5px solid #2269a5;padding:16px}.caution{background:#fff0dc;border-left:5px solid #c78322;padding:16px}small{color:#53647b}figure{margin:25px 0}figcaption{font-size:14px;color:#53647b}code{background:#eaf0f7;padding:1px 4px}'\\n    parts=[f'<!doctype html><html lang=\\\"en\\\"><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>3I/ATLAS solar-wind MHD — Codex</title><style>{css}</style><body>',\\n    '<h1>3I/ATLAS: a 3D solar-wind reconstruction</h1>',\\n    f'<p><small>Author: Codex-root with Codex observation, external-model and solver sub-agents. Generated {datetime.now(timezone.utc).isoformat()}.</small></p>',\\n    f'<p class=\\\"lead\\\">{stage} The reference run <code>{esc(best)}</code> gives PN-good-time-weighted proton density <b>{f(v[\\\"n\\\"])} cm⁻³</b>, heliocentric speed <b>{f(v[\\\"v\\\"])} km/s</b>, and incident proton flux <b>{f(v[\\\"f_incident\\\"])} cm⁻² s⁻¹</b>. These are model-dependent estimates, not measurements at the comet.</p>',\\n    '<p><a href=\\\"figures/comet_timeseries.png\\\">Time-series chart</a> · <a href=\\\"results/comet_timeseries.csv\\\">Numerical time series</a> · <a href=\\\"figures/solar_wind_topdown.mp4\\\">Top-down animation</a> · <a href=\\\"figures/solar_wind_flux_contrast.mp4\\\">Stream-contrast animation</a> · <a href=\\\"results/summary.json\\\">Machine-readable results</a> · <a href=\\\"README.txt\\\">Reproduction guide</a></p>',\\n    '<figure><img src=\\\"figures/comet_timeseries.png\\\" alt=\\\"Density, speed and incident-flux time series\\\"><figcaption>Curves span the complete published pointing interval. Gray bands are accepted PN intervals. The envelope contains tested parameters and numerical variants; it is not a confidence interval or an exhaustive error bound.</figcaption></figure>',\\n    '<h2>Epoch, frame and incident flux</h2>',\\n    '<p>The published pointing sequence spans 2025-12-03 12:37:38 to 2025-12-04 17:22:29 UTC. The existing analysis_06 bounds, 12:04:07 to 10:11:54 the next day, describe retained frame metadata rather than accepted science exposure. The 45 accepted PN intervals instead begin at 13:04:03.002 and end at 09:56:03.002, totaling 21,362.284 s. All quoted exposure-weighted means integrate the model over these exact intervals. <a href=\\\"observations/xmm_gtis.tsv\\\">GTIs and original FITS paths</a>; <a href=\\\"observations/evidence_report.txt\\\">evidence report</a>.</p>',\\n    '<p>The mesh uses the fixed solar equator and the ascending node on the J2000 ecliptic as longitude zero. Full geometric JPL Horizons vectors use UTC explicitly. Carrington maps rotate at 14.1844° per day; their phase is anchored by GONG sub-Earth longitude and the actual Earth vector. The independent IAU phase differs by only 0.169°, while per-map phase residuals reach 0.731°. WSA map orientation was checked against the original magnetogram (correlation 0.9855); treating the generic DU documentation as the exact GONG pixel origin would be incorrect here. <a href=\\\"observations/frame_phase_audit.json\\\">Independent phase audit</a>; <a href=\\\"external_model/coordinate_verification.json\\\">pixel check</a>.</p>',\\n    '<p>The ordinary heliocentric flux is F=nₚ|vSW|. The physically incident flux used in the final flux chart is Fincident=nₚ|vSW−vcomet|. The comet moves outward at about 43 km/s radially and 66 km/s in total, so the distinction is several percent to approximately 10%. Both fluxes and both speeds are retained in the CSV. No spacecraft was treated as being co-located with the comet.</p>',\\n    '<h2>Inputs and physical closure</h2>',\\n    '<p>The solar input is 25 actual daily WSA 5.4 maps, driven by GONGZ photospheric magnetograms, from November 10 through December 4. WSA supplies radial field and empirical speed at 21.5 solar radii (0.099985 AU). Its coronal calculation uses PFSS and a Schatten current-sheet extension; this project implements the heliospheric MHD stage, rather than rebuilding that upstream coronal model. <a href=\\\"https://ccmc.gsfc.nasa.gov/models/WSA~5.4/\\\">Official WSA model description</a>; <a href=\\\"external_model/provenance.json\\\">retrieval URLs and hashes</a>.</p>',\\n    f'<p>Pre-epoch STEREO-A and Solar Orbiter measurements over November 10–24 set instrument-balanced density, magnetic and thermal normalizations. Wind is entirely held out. The calibrated boundary uses n₄₀₀={f(m[\\\"density_1au_at400_cm3\\\"])} cm⁻³ at 1 AU, T₄₀₀={f(m[\\\"proton_temperature_01au_at400_K\\\"])} K at the inner boundary, and a WSA field multiplier {f(m[\\\"WSA_Br_multiplier\\\"])}. Constant momentum flux sets n∝v⁻² and constant thermal pressure sets T∝v². Pressure is 2nₚkBTₚ, assuming equal electron and proton temperatures. The chosen WSA-to-MHD speed reduction is 50 km/s; it is tested as an uncertain model choice, not represented as the exact ENLIL boundary transformation.</p>',\\n    '<p>STEREO-A is only about 1.1° away from the comet in solar latitude; Solar Orbiter is about 15.9° away. Their training density-normalization medians differ substantially (6.05 versus 11.25 cm⁻³), motivating separate low/high-density experiments. Spacecraft normalization does not recover the neutral coma, heavy-ion charge states or a unique unobserved density map. A prior heavy-ion fraction 3×10⁻⁴–10⁻³ could be applied to proton flux conditionally, but it is not a contemporaneous heavy-ion measurement.</p>',\\n    '<p>Leading-order source ranking is: magnetogram-driven coronal speed/field maps; native plasma density, velocity, magnetic field and temperature; and coronagraph/CME constraints. F10.7 is useful activity context but is not a local density or ion-composition measurement. LASCO imagery and the frozen DONKI-derived cone catalogue were inspected; the selected reviewer model changes comet flux by only about 1% at most between CME and ambient runs during the PN window. Omitting explicit CME injection is conditional on that result and does not exclude missed or misdirected transients. <a href=\\\"external_model/report.txt\\\">Remote-sensing research and primary sources</a>.</p>',\\n    '<h2>Numerical implementation and tests</h2>',\\n    '<p>The C++17 solver evolves mass, three Cartesian momentum components, total energy, three magnetic components and a GLM cleaning variable in all three spatial directions. Exact integrated spherical face-area vectors handle geometry; MC-limited MUSCL reconstruction, a Rusanov flux and SSPRK2 advance the solution. Solar gravity is included. The main closure γ=1.5 represents effective distributed heating; γ=5/3 is a sensitivity experiment, not an exact reproduction of ENLIL’s explicit heating. Radial boundaries are imposed wind/outflow, longitude is periodic, and latitude boundaries extrapolate spherical components. Rejected high-order steps use a recorded first-order fallback; no hidden density or pressure floors are used. <a href=\\\"solver/README.md\\\">Solver equations and implementation</a>.</p>',\\n    '<p>The production shell reaches 2.3 AU. Low-resolution experiments preceded refinements. Both ±30° and ±60° latitude domains were tested because radial superfast flow does not remove transverse causal communication. At the inner boundary the characteristic fast speed is a substantial fraction of radial speed, so a narrow angular wedge requires an explicit domain test.</p>',\\n    f'<p>Uniform Cartesian MHD is preserved to float-output precision. The cold radial mass-flux errors decrease 1.235% → 0.331% → 0.104%. The Brio–Wu shock tube keeps normal field exactly constant and density L1 error against a 1600-cell reference decreases 0.01358 → 0.005794 at 400 → 800 cells. Synthetic fast/slow streams develop nonradial flow while remaining positive. These verify numerical behavior; self-comparison against a fine reference does not constitute an independent exact MHD Riemann solution. <a href=\\\"solver/tests/verification.json\\\">Test metrics</a>; <a href=\\\"https://flash.rochester.edu/site/flashcode/user_support/flash_ug_devel/node192.html\\\">Canonical Brio–Wu definition</a>.</p>',\\n    '<h2>Refinement, domain and additional-physics checks</h2>',\\n    f'<p>Criteria were recorded before reviewing production refinements: maximum pointwise differences ≤10% for density and flux, ≤5% for speed; halving the timestep should change each by ≤1%. Current Boolean results: <b>{esc(statuses)}</b>. These tests cover the complete published interval. A pass establishes adequate resolution only for the chosen macroscopic inputs and numerical method.</p>',\\n    table(['Comparison','Max density Δ','Max speed Δ','Max heliocentric flux Δ'],comparisonrows),\\n    '<p>Latitude-width experiments must be interpreted separately from cell-resolution experiments. The early coarse ±30°/±60° comparison changes flux by approximately 14%; that is measured sensitivity, not a validated ±14% uncertainty bound. Comparisons of different numerical fluxes also need to remain separate from domain comparisons. Exact-GLM preprocessing with the original dissipation changes the coarse PN flux by less than 1%, whereas a split GLM treatment with lower transverse dissipation can change it much more. This numerical-method dependence must not be hidden behind a single successful refinement test. <a href=\\\"solver/diagnostics/\\\">Full divergence and scheme diagnostics</a>; <a href=\\\"external_model/domain_audit.txt\\\">independent domain assessment</a>.</p>',\\n    '<p>GLM cleaning leaves nonzero magnetic divergence. The medium comet-neighborhood h|div B|/|B| decreases from about 0.018 to 0.006, and its nearest-cell value is about 0.003. A monopole-force scale is small relative to bulk inertia, but that ratio is not a rigorous accumulated-flux error bound. These calculations do not establish a converged magnetic topology. Coarse controls below quantify changing B, temperature, speed, density and γ; they are sensitivity experiments with the same coarse grid, not uncertainty percentiles.</p>',\\n    table(['Control versus coarse','Max density Δ','Max speed Δ','Max flux Δ'],physicalrows),\\n    '<p><a href=\\\"figures/convergence.png\\\">Resolution/timestep chart</a> · <a href=\\\"validation/criteria.json\\\">Original criteria</a> · <a href=\\\"results/summary.json\\\">All detailed metrics</a></p>',\\n    '<h2>Native observations and the reviewer’s model</h2>',\\n    '<p>Native spacecraft comparisons use November 25 onward, with no Parker time mapping, fitted phase shift or amplitude tuning. This tests the model at actual measurement positions rather than using mapped observations at the unmeasured comet. The amplitude calibration improves density/flux relative to the reviewer’s uncalibrated ENLIL run, while temporal correlations and peaks remain imperfect. Spatially separated monitor residuals cannot be converted directly into a calibrated comet confidence interval. <a href=\\\"validation/inhouse_native.json\\\">Exact metrics and coverage</a>.</p>',\\n    '<figure><img src=\\\"validation/inhouse_native.png\\\" alt=\\\"Native observations compared with both models\\\"><figcaption>Independent Wind validation and post-training STEREO-A/Solar Orbiter checks. Figures do not extrapolate a model past its final time.</figcaption></figure>',\\n    '<p>The downloaded reviewer run is Jan_Deca_120925_SH_1, ENLIL 2.8f-beta, WSA 5.4/GONGZ, 576×24×90 over 0.1–3.1 AU and ±48°, with 64 selected cone CMEs. Its original analysis_06-window medians at the comet are n≈1.05 cm⁻…1873 tokens truncated…ormatter('%d %b %H:%M'))\\n    fig.savefig(ROOT/'figures/manuscript_lightcurve_comparison.png',dpi=180);plt.close(fig)\\n    print(json.dumps({k:v for k,v in report.items() if k!='rows'},indent=2))\\n\\nif __name__=='__main__':main()\\n\"}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"919018\",\"wall_time_seconds\":0.000009893,\"exit_code\":0,\"original_token_count\":4836,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Derive comet-frame incident flux, exposure weighting and scientific figures.\\\"\\\"\\\"\\nfrom pathlib import Path\\nimport csv, json\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use('Agg')\\nimport matplotlib.pyplot as plt\\nimport matplotlib.dates as mdates\\nfrom astropy.time import Time\\n\\nROOT=Path(__file__).resolve().parents[1]\\nORIGIN=60980.\\nOBS=ROOT/'observations'; FIG=ROOT/'figures'\\nWINDOW=(Time('2025-12-03T12:37:38').mjd-ORIGIN,Time('2025-12-04T17:22:29').mjd-ORIGIN)\\n\\ndef tsv(path):\\n    return np.genfromtxt(path,names=True,delimiter='\\\\t',dtype=None,encoding='utf8')\\n\\ndef csv_table(path):\\n    return np.genfromtxt(path,names=True,delimiter=',')\\n\\ndef comet_velocity(day):\\n    e=tsv(OBS/'ephemeris_comet.tsv')\\n    basis=np.array(json.loads((OBS/'coordinate_system.json').read_text())['ecliptic_to_solar_equatorial_matrix'])\\n    pos=np.array([np.interp(day+ORIGIN,e['mjd_utc'],e[k]) for k in ['x_au','y_au','z_au']]).T@basis.T\\n    vel=np.array([np.interp(day+ORIGIN,e['mjd_utc'],e[k]) for k in ['vx_au_day','vy_au_day','vz_au_day']]).T@basis.T*149597870.7/86400\\n    r=np.linalg.norm(pos,axis=-1); phi=np.arctan2(pos[:,1],pos[:,0]);theta=np.arccos(pos[:,2]/r)\\n    er=pos/r[:,None]; et=np.array([np.cos(theta)*np.cos(phi),np.cos(theta)*np.sin(phi),-np.sin(theta)]).T\\n    ep=np.array([-np.sin(phi),np.cos(phi),np.zeros_like(phi)]).T\\n    return np.array([np.sum(vel*vec,axis=-1) for vec in [er,et,ep]]).T\\n\\ndef own_case(name,folder=None):\\n    a=csv_table((folder or ROOT/'results'/name)/'probe.csv');a=a[a['probe_id']==0]\\n    vc=comet_velocity(a['day'])\\n    w=np.column_stack([a['vr_kms'],a['vtheta_kms'],a['vphi_kms']])\\n    rel=np.linalg.norm(w-vc,axis=1)\\n    return {'day':a['day'],'n':a['n_cm3'],'v':a['speed_kms'],'f':a['flux_cm2_s'],\\n        'v_rel':rel,'f_incident':a['n_cm3']*rel*1e5}\\n\\ndef ccmc_case(key):\\n    z=np.load(ROOT/'external_model/ccmc_profiles.npz');fields=list(z['fields']);a=z[key]\\n    d={str(k):a[:,j] for j,k in enumerate(fields)};day=d['mjd']-ORIGIN\\n    use=(day>=14)&(day<=34);d={k:v[use] for k,v in d.items()};day=day[use]\\n    vc=comet_velocity(day)\\n    # ENLIL RTN uses T east and N north; solver theta points south.\\n    w=np.column_stack([d['vr_kms'],-d['vn_kms'],d['vt_kms']])\\n    rel=np.linalg.norm(w-vc,axis=1)\\n    return {'day':day,'n':d['n_cm3'],'v':d['speed_kms'],'f':d['flux_cm2_s'],\\n        'v_rel':rel,'f_incident':d['n_cm3']*rel*1e5}\\n\\ndef integrate(a,key,start,stop):\\n    inside=a['day'][(a['day']>start)&(a['day']<stop)]\\n    knots=np.r_[start,inside,stop]\\n    return np.trapezoid(np.interp(knots,a['day'],a[key]),knots)\\n\\ndef stats(a,spans):\\n    duration=sum(b-s for s,b in spans)\\n    return {key:sum(integrate(a,key,s,b) for s,b in spans)/duration for key in ['n','v','f','v_rel','f_incident']}\\n\\ndef relative_comparison(a,b,window=WINDOW):\\n    t=a['day'];use=(t>=window[0])&(t<=window[1]);t=t[use]\\n    return {k:{'maximum_relative_difference':float(np.max(np.abs(a[k][use]/np.interp(t,b['day'],b[k])-1))),\\n        'median_relative_difference':float(np.median(a[k][use]/np.interp(t,b['day'],b[k])-1)),\\n        'rms_relative_difference':float(np.sqrt(np.mean((a[k][use]/np.interp(t,b['day'],b[k])-1)**2)))} for k in ['n','v','f','f_incident']}\\n\\ndef main():\\n    FIG.mkdir(exist_ok=True)\\n    cases={p.name:own_case(p.name) for p in (ROOT/'results').iterdir() if (p/'statistics.json').exists() and p.name not in ['pilot','interrupted_wide_medium']}\\n    best=next(k for k in ['wide_fine','wide_medium','fine','medium','coarse'] if k in cases)\\n    comparisons={'ccmc_cme':ccmc_case('3I-Atlas1'),'ccmc_ambient':ccmc_case('3I-Atlas2amb')}\\n    scheme_cases={}\\n    for name,dirname in [('split_coarse','coarse_split_glm'),('split_medium','medium_split_glm')]:\\n        directory=ROOT/'solver/experiments'/dirname\\n        if (directory/'statistics.json').exists():scheme_cases[name]=own_case(name,folder=directory)\\n    allcases={**cases,**comparisons,**scheme_cases}\\n    gti=tsv(OBS/'xmm_gtis.tsv');gti=gti[gti['detector']=='pn']\\n    spans=list(zip(gti['start_mjd_utc']-ORIGIN,gti['stop_mjd_utc']-ORIGIN))\\n    baseline=json.loads((OBS/'baseline_result.json').read_text())\\n    baseline_spans=[tuple(Time(baseline['observation_utc']).mjd-ORIGIN)]\\n    summary={'reference_case':best,'published_window_day':WINDOW,'PN_good_exposure_seconds':sum(b-a for a,b in spans)*86400,\\n        'definitions':{'n':'proton number density, cm^-3','v':'heliocentric bulk speed, km/s',\\n            'f':'conventional heliocentric proton flux n|vSW|, cm^-2 s^-1',\\n            'v_rel':'comet-frame relative wind speed |vSW-vComet|, km/s',\\n            'f_incident':'incident proton flux n|vSW-vComet|, cm^-2 s^-1'},\\n        'cases':{},'numerical_comparisons':{},'parameter_comparisons':{},'scheme_comparisons':{},\\n        'caveat':'Parameter min/max envelope is a sensitivity range, not a confidence interval. No contemporaneous heavy-ion abundance measured at the comet.'}\\n    for name,a in allcases.items():\\n        use=(a['day']>=WINDOW[0])&(a['day']<=WINDOW[1])\\n        summary['cases'][name]={'PN_GTI_weighted_mean':stats(a,spans),'analysis06_window_mean':stats(a,baseline_spans),\\n            'published_window':{k:{'min':float(a[k][use].min()),'median':float(np.median(a[k][use])),\\n                'max':float(a[k][use].max())} for k in ['n','v','f','v_rel','f_incident']}}\\n    for left,right in [('coarse','medium'),('medium','fine'),('time_half','medium'),('wide_coarse','coarse'),('domain45','wide_coarse'),('wide_coarse','wide_medium'),('wide_medium','wide_fine'),('fine','wide_fine'),('wide_movie','wide_medium')]:\\n        if left in cases and right in cases: summary['numerical_comparisons'][left+'_vs_'+right]=relative_comparison(cases[left],cases[right])\\n    for name,a in cases.items():\\n        if name not in ['coarse','medium','fine','time_half','wide_coarse','wide_medium','wide_fine','domain45','wide_movie']:\\n            summary['parameter_comparisons'][name+'_vs_coarse']=relative_comparison(a,cases['coarse'])\\n    for name,a in scheme_cases.items():\\n        baseline='coarse' if name=='split_coarse' else 'medium'\\n        summary['scheme_comparisons'][name+'_vs_'+baseline]=relative_comparison(a,cases[baseline])\\n    thresholds=json.loads((ROOT/'validation/criteria.json').read_text())\\n    comp=summary['numerical_comparisons'].get('medium_vs_fine')\\n    summary['spatial_thresholds_passed']=bool(comp and all(comp[k]['maximum_relative_difference']<=thresholds['spatial_maximum_relative_difference_targets'][label] for k,label in [('n','density'),('v','speed'),('f','flux')]))\\n    comp=summary['numerical_comparisons'].get('time_half_vs_medium')\\n    summary['temporal_threshold_passed']=bool(comp and all(comp[k]['maximum_relative_difference']<=.01 for k in ['n','v','f']))\\n    comp=summary['numerical_comparisons'].get('wide_medium_vs_wide_fine')\\n    summary['wide_spatial_thresholds_passed']=bool(comp and all(comp[k]['maximum_relative_difference']<=thresholds['spatial_maximum_relative_difference_targets'][label] for k,label in [('n','density'),('v','speed'),('f','flux')]))\\n    # Native-resolution CSV throughout the observation and adjacent context.\\n    a=cases[best];selected=(a['day']>=32)&(a['day']<=34)\\n    headers=['utc','day','density_cm3','speed_heliocentric_kms','flux_heliocentric_cm2_s','relative_speed_comet_kms','incident_flux_cm2_s']\\n    with (ROOT/'results/comet_timeseries.csv').open('w',newline='') as f:\\n        w=csv.writer(f);w.writerow(headers)\\n        for i in np.where(selected)[0]: w.writerow([Time(a['day'][i]+ORIGIN,format='mjd').isot,a['day'][i]]+[a[k][i] for k in ['n','v','f','v_rel','f_incident']])\\n    (ROOT/'results/summary.json').write_text(json.dumps(summary,indent=2)+'\\\\n')\\n    # Three requested 1D charts; show actual observing gaps, no error-bar claim.\\n    plt.rcParams.update({'font.family':'DejaVu Sans','font.size':10,'axes.spines.top':False,'axes.spines.right':False})\\n    times=np.linspace(*WINDOW,350);dates=Time(times+ORIGIN,format='mjd').to_datetime()\\n    bandcases=[v for k,v in {**cases,**scheme_cases}.items() if k not in ['coarse','time_half','early_start','wide_coarse']]\\n    fig,axs=plt.subplots(3,1,figsize=(10,8.6),sharex=True,layout='constrained')\\n    for ax,key,label,scale in zip(axs,['n','v','f_incident'],[r'Proton density (cm$^{-3}$)',r'Bulk speed (km s$^{-1}$)',r'Incident proton flux ($10^7$ cm$^{-2}$ s$^{-1}$)'],[1,1,1e7]):\\n        stack=np.array([np.interp(times,b['day'],b[key]) for b in bandcases])/scale\\n        ax.fill_between(dates,stack.min(axis=0),stack.max(axis=0),color='#1860a5',alpha=.13,label='tested-case envelope (not CI)')\\n        ax.plot(dates,np.interp(times,a['day'],a[key])/scale,color='#155da2',lw=2,label=f'In-house 3D MHD ({best})')\\n        c=comparisons['ccmc_cme'];ax.plot(dates,np.interp(times,c['day'],c[key])/scale,color='#d77623',lw=1.8,label='CCMC WSA–ENLIL + CME')\\n        if key=='f_incident':\\n            ax.plot(dates,np.interp(times,a['day'],a['f'])/scale,color='#155da2',lw=1,ls=':',label=r'In-house heliocentric $n|v|$')\\n        for start,stop in spans: ax.axvspan(Time(start+ORIGIN,format='mjd').to_datetime(),Time(stop+ORIGIN,format='mjd').to_datetime(),color='0.4',alpha=.10,lw=0)\\n        ax.set_ylabel(label);ax.grid(alpha=.18);ax.set_xlim(dates[0],dates[-1])\\n    axs[0].legend(loc='upper left',fontsize=8,ncol=2)\\n    axs[-1].legend(loc='upper left',fontsize=8,ncol=2)\\n    axs[0].set_title('3I/ATLAS during XMM–Newton | 3–4 December 2025 UTC',loc='left',weight='bold')\\n    axs[-1].xaxis.set_major_formatter(mdates.DateFormatter('%d %b\\\\n%H:%M'))\\n    axs[-1].set_xlabel('UTC; gray intervals are accepted PN good times')\\n    fig.savefig(FIG/'comet_timeseries.png',dpi=180);fig.savefig(FIG/'comet_timeseries.pdf');plt.close(fig)\\n    # Separate files support straightforward export into a paper.\\n    for key,label,filename,scale in [('n',r'Proton density (cm$^{-3}$)','density',1),('v','Heliocentric speed (km/s)','speed',1),('f_incident',r'Incident proton flux ($10^7$ cm$^{-2}$ s$^{-1}$)','flux',1e7)]:\\n        fig,ax=plt.subplots(figsize=(8,3.3),layout='constrained')\\n        ax.plot(dates,np.interp(times,a['day'],a[key])/scale,label='In-house 3D MHD')\\n        c=comparisons['ccmc_cme'];ax.plot(dates,np.interp(times,c['day'],c[key])/scale,label='CCMC ENLIL')\\n        ax.set_ylabel(label);ax.set_xlabel('UTC, 3–4 December 2025');ax.xaxis.set_major_formatter(mdates.DateFormatter('%d %b %H:%M'));ax.grid(alpha=.2);ax.legend(fontsize=8)\\n        fig.savefig(FIG/f'{filename}.png',dpi=180);plt.close(fig)\\n    # Resolution comparison relative to finest grid.\\n    if 'fine' in cases:\\n        fig,axs=plt.subplots(3,1,figsize=(9,7),sharex=True,layout='constrained')\\n        for ax,key in zip(axs,['n','v','f']):\\n            ref=np.interp(times,cases['fine']['day'],cases['fine'][key])\\n            for name in ['coarse','medium','time_half']:\\n                if name in cases: ax.plot(dates,100*(np.interp(times,cases[name]['day'],cases[name][key])/ref-1),label=name)\\n            ax.axhline(0,color='0.5',lw=.7);ax.set_ylabel({'n':'Density','v':'Speed','f':'Flux'}[key]+' error (%)');ax.grid(alpha=.2)\\n        axs[0].legend(ncol=3);axs[0].set_title('Grid and timestep sensitivity relative to 96 × 12 × 96',loc='left')\\n        axs[-1].xaxis.set_major_formatter(mdates.DateFormatter('%d %b %H:%M'))\\n        fig.savefig(FIG/'convergence.png',dpi=180);plt.close(fig)\\n    if 'wide_fine' in cases:\\n        fig,axs=plt.subplots(3,1,figsize=(9,7),sharex=True,layout='constrained')\\n        for ax,key in zip(axs,['n','v','f']):\\n            ref=np.interp(times,cases['wide_fine']['day'],cases['wide_fine'][key])\\n            for name in ['wide_coarse','wide_medium','fine']:\\n                if name in cases:ax.plot(dates,100*(np.interp(times,cases[name]['day'],cases[name][key])/ref-1),label=name)\\n            ax.axhline(0,color='0.5',lw=.7);ax.set_ylabel({'n':'Density','v':'Speed','f':'Flux'}[key]+' difference (%)');ax.grid(alpha=.2)\\n        axs[0].legend(ncol=3);axs[0].set_title('Wide-domain refinement and latitude-domain comparison',loc='left')\\n        axs[-1].xaxis.set_major_formatter(mdates.DateFormatter('%d %b %H:%M'))\\n        fig.savefig(FIG/'wide_convergence.png',dpi=180);plt.close(fig)\\n    print(json.dumps({'reference':best,'PN_GTI_mean':summary['cases'][best]['PN_GTI_weighted_mean'],\\n        'spatial_pass':summary['spatial_thresholds_passed'],'time_pass':summary['temporal_threshold_passed'],\\n        'numerical_comparisons':summary['numerical_comparisons']},indent=2))\\n\\nif __name__=='__main__': main()\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Export an actual MHD ecliptic slice, with projected solar-system geometry.\\\"\\\"\\\"\\nfrom pathlib import Path\\nimport argparse, json\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use('Agg')\\nimport matplotlib.pyplot as plt\\nfrom matplotlib.animation import FuncAnimation, FFMpegWriter, PillowWriter\\nfrom matplotlib.colors import LogNorm\\nfrom matplotlib.patches import Circle\\nfrom scipy.interpolate import RegularGridInterpolator\\nfrom astropy.time import Time\\nfrom astropy.coordinates import get_body_barycentric\\n\\nROOT=Path(__file__).resolve().parents[1]\\n\\ndef main():\\n    p=argparse.ArgumentParser();p.add_argument('--case',default='medium');p.add_argument('--gif',action='store_true');p.add_argument('--scaled',action='store_true',help='Additional explicitly radius-normalized flux-contrast view');args=p.parse_args()\\n    folder=ROOT/'results'/args.case\\n    records=np.genfromtxt(folder/'snapshots.csv',delimiter=',',names=['day','filename'],skip_header=1,dtype=None,encoding='utf8')\\n    r,th,ph=[np.load(folder/f'{name}.npy') for name in ['r_au','theta_rad','phi_rad']]\\n    basis=np.array(json.loads((ROOT/'observations/coordinate_system.json').read_text())['ecliptic_to_solar_equatorial_matrix'])\\n    axis=np.linspace(-2.3,2.3,460)\\n    xx,yy=np.meshgrid(axis,axis)\\n    flat=np.column_stack([xx.ravel(),yy.ravel(),np.zeros(xx.size)])@basis.T\\n    rr=np.linalg.norm(flat,axis=1)\\n    theta=np.arccos(np.divide(flat[:,2],rr,out=np.zeros_like(rr),where=rr>0))\\n    phi=np.arctan2(flat[:,1],flat[:,0])%(2*np.pi)\\n    points=np.column_stack([rr,theta,phi])\\n    extended_phi=np.r_[ph[-1]-2*np.pi,ph,ph[0]+2*np.pi]\\n    def slice_flux(filename):\\n        a=np.load(folder/filename)\\n        # Interpolate scalar density and vector speed separately to avoid\\n        # interpreting a theta component as a Cartesian direction.\\n        flux=a[...,0]*np.linalg.norm(a[...,1:4],axis=-1)*1e5\\n        if args.scaled: flux=flux*r[:,None,None]**2\\n        flux=np.concatenate([flux[...,-1:],flux,flux[...,:1]],axis=-1)\\n        interp=RegularGridInterpolator((r,th,extended_phi),flux,bounds_error=False,fill_value=np.nan)\\n        return interp(points).reshape(xx.shape)\\n    times=records['day']; dates=Time(times+60980,format='mjd',scale='utc')\\n    eps=np.deg2rad(84381.448/3600); rot=np.array([[1,0,0],[0,np.cos(eps),np.sin(eps)],[0,-np.sin(eps),np.cos(eps)]])\\n    sun=get_body_barycentric('sun',dates)\\n    tracks={}\\n    for name in ['mercury','venus','earth','mars']:\\n        tracks[name]=((get_body_barycentric(name,dates)-sun).xyz.value.T@rot.T)\\n    for name in ['comet','stereo_a','solar_orbiter']:\\n        a=np.genfromtxt(ROOT/'observations'/f'ephemeris_{name}.tsv',delimiter='\\\\t',names=True,dtype=None,encoding='utf8')\\n        tracks[name]=np.column_stack([np.interp(times+60980,a['mjd_utc'],a[k]) for k in ['x_au','y_au','z_au']])\\n    plt.rcParams.update({'font.family':'DejaVu Sans','font.size':10,'text.color':'#e6edf6','axes.labelcolor':'#e6edf6',\\n        'xtick.color':'#c0cbd9','ytick.color':'#c0cbd9','axes.edgecolor':'#48536a','savefig.facecolor':'#0b101b'})\\n    fig,ax=plt.subplots(figsize=(9.2,8.5),facecolor='#0b101b',layout='constrained');ax.set_facecolor('#0b101b')\\n    cmap=plt.get_cmap('magma').copy();cmap.set_bad('#0b101b')\\n    initial=slice_flux(records['filename'][0])\\n    low,high=(1e8,8e8) if args.scaled else (1e7,3e10)\\n    im=ax.imshow(initial,origin='lower',extent=[-2.3,2.3,-2.3,2.3],cmap=cmap,norm=LogNorm(low,high),interpolation='bilinear')\\n    cb=fig.colorbar(im,ax=ax,fraction=.045,pad=.025)\\n    cb.set_label(r'1-AU-equivalent flux $n_p|v_{SW}|(r/\\\\mathrm{AU})^2$ (cm$^{-2}$ s$^{-1}$)' if args.scaled else r'Proton flux $n_p|v_{SW}|$ (cm$^{-2}$ s$^{-1}$)')\\n    for rad in [.5,1,1.5,2]:\\n        ax.add_patch(Circle((0,0),rad,fill=False,ec='#d6e2f4',lw=.6,alpha=.28))\\n    ax.plot(0,0,'o',color='#ffd464',markersize=9,label='Sun',zorder=10)\\n    colors={'mercury':'#a6a9ad','venus':'#ffe1b8','earth':'#75c6ff','mars':'#ff927b',\\n        'comet':'#82ffd4','stereo_a':'#f7f1a1','solar_orbiter':'#ecbcff'}\\n    names={'mercury':'Mercury','venus':'Venus','earth':'Earth / Wind','mars':'Mars','comet':'3I/ATLAS','stereo_a':'STEREO-A','solar_orbiter':'Solar Orbiter'}\\n    markers={}; labels={}\\n    for name,track in tracks.items():\\n        ax.plot(track[:,0],track[:,1],color=colors[name],lw=.65,alpha=.6)\\n        markers[name],=ax.plot([track[0,0]],[track[0,1]],'D' if name=='comet' else 'o',ms=5.5 if name=='comet' else 4,color=colors[name],zorder=8)\\n        labels[name]=ax.annotate(names[name],track[0,:2],xytext=(6,6),textcoords='offset points',color=colors[name],fontsize=8,zorder=10)\\n    title=ax.set_title('',loc='left',fontsize=13,weight='bold',pad=12)\\n    ax.set(xlim=(-2.3,2.3),ylim=(-2.3,2.3),xlabel='Heliocentric ecliptic J2000 x (AU)',ylabel='Heliocentric ecliptic J2000 y (AU)',aspect='equal')\\n    ax.text(.02,.02,'Ecliptic slice of the 3D MHD solution\\\\nMarkers are projected; comet samples use its actual latitude.',transform=ax.transAxes,color='#d1dbe9',fontsize=8,va='bottom',bbox={'facecolor':'#0b101b','alpha':.70,'edgecolor':'none','pad':5})\\n    def frame(i):\\n        im.set_data(slice_flux(records['filename'][i]))\\n        for name,track in tracks.items():\\n            markers[name].set_data([track[i,0]],[track[i,1]]);labels[name].xy=track[i,:2]\\n        stamp=dates[i].isot[:16].replace('T',' ')\\n        title.set_text(f'{\\\"Wind-stream contrast\\\" if args.scaled else \\\"Solar-wind propagation to 2.3 AU\\\"} | {stamp} UTC')\\n        return [im,title,*markers.values(),*labels.values()]\\n    frame(0)\\n    animation=FuncAnimation(fig,frame,frames=len(records),interval=160,blit=False)\\n    dest=ROOT/'figures';dest.mkdir(exist_ok=True)\\n    stem='solar_wind_flux_contrast' if args.scaled else 'solar_wind_topdown'\\n    animation.save(dest/f'{stem}.mp4',writer=FFMpegWriter(fps=6,codec='libx264',bitrate=1800,extra_args=['-threads','2','-pix_fmt','yuv420p']),dpi=120)\\n    if args.gif: animation.save(dest/f'{stem}.gif',writer=PillowWriter(fps=6),dpi=75)\\n    index=int(np.argmin(abs(times-32.75)));frame(index);fig.savefig(dest/f'{stem}.png',dpi=180)\\n    plt.close(fig)\\n    (dest/(stem+'_metadata.json')).write_text(json.dumps({'case':args.case,'frames':len(records),'start_utc':dates[0].isot,'end_utc':dates[-1].isot,\\n        'flux_definition':'np|vSW|*(r/AU)^2, radius-normalized contrast only' if args.scaled else 'heliocentric np|vSW|, NOT radius-normalized','units':'cm^-2 s^-1','colormap_range':[low,high],\\n        'slice':'fixed J2000 ecliptic z=0; exact 3D interpolation in solar-equatorial mesh','markers':'planet and spacecraft positions projected to ecliptic plane',\\n        'planet_ephemerides':'Astropy builtin solar-system ephemeris, Sun centered; spacecraft and comet JPL Horizons geometric vectors',\\n        'snapshots_are_simulation_data':True},indent=2)+'\\\\n')\\n    print('Animation and preview written:',dest)\\n\\nif __name__=='__main__': main()\\n\"}}","source_line":520,"directed_to":[],"call_id":"call_7eb243cebcfa451ea07381fc7fd35c61"},{"id":"01a146d8-e4b4-7911-bce2-ed7d65e2115e-523-0","timestamp":"2026-10-16T22:57:38.335Z","role":"assistant","kind":"unavailable","text":"Reasoning is encrypted in the local session log; plaintext is unavailable