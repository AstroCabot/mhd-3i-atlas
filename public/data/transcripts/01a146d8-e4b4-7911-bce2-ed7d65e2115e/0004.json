_density_difference_cm3':float(np.max(np.abs(d[mask,4]-a[mask,4]))),\\n        'maximum_absolute_speed_difference_kms':float(np.max(np.abs(d[mask,14]-a[mask,14])))}\\n    with (BASE/'ccmc_comet_observation.csv').open('w',newline='') as f:\\n        w=csv.writer(f);w.writerow(['utc',*FIELDS,'ambient_density_cm3','ambient_speed_kms','ambient_flux_cm2_s'])\\n        for row,amb in zip(d[mask],a[mask]):\\n            w.writerow([Time(row[0],format='mjd').isot,*row,amb[4],amb[14],amb[15]])\\n    (BASE/'summary.json').write_text(json.dumps(summary,indent=2))\\n\\n    maps=[]; metadata=[]\\n    for f in sorted(RAW.glob('vel_*fits')):\\n        with fits.open(f) as hdus:\\n            h=hdus[0].header;data=np.asarray(hdus[0].data,dtype=np.float32)\\n            maps.append(data)\\n            metadata.append({'file':str(f.relative_to(BASE)),\\n                'obs_mjd':float(h['OBSJUL'])-2400000.5,\\n                'obs_utc':Time(float(h['OBSJUL']),format='jd').isot,\\n                **{k:h[k] for k in ['CARROT','CARRLONG','OBSCAR','OBSLON','OBSTIME','RADOUT','GRID','PROVERS','FILELIST','VELEQN']}})\\n    maps=np.asarray(maps)\\n    # WSA images preserve the longitude order and south-to-north latitude order of GONG.\\n    lat=-89+np.arange(90)*2\\n    lon=np.asarray([(m['CARRLONG']+1+2*np.arange(180))%360 for m in metadata])\\n    np.savez_compressed(BASE/'boundaries.npz', br_nT=maps[:,0], speed_kms=maps[:,1],\\n                        obs_mjd=np.asarray([m['obs_mjd'] for m in metadata]),\\n                        latitude_deg=lat, carrington_longitude_deg=lon,\\n                        subearth_carrington_longitude_deg=np.asarray([m['OBSLON'] for m in metadata]),\\n                        leading_edge_carrington_longitude_deg=np.asarray([m['CARRLONG'] for m in metadata]))\\n    out=fits.getdata(RAW/'wsa_202511280014R000_gong_z.fits')\\n    gong=fits.getdata(RAW/'mrzqs251128t0014c2305_327.fits.gz')\\n    gong_lat=np.rad2deg(np.arcsin((np.arange(180)+.5-90)/90))\\n    interp=RegularGridInterpolator((gong_lat,np.arange(360)+.5),gong,bounds_error=False,fill_value=None)\\n    yg,xg=np.meshgrid(lat,np.arange(180)*2+1,indexing='ij')\\n    gp=interp(np.stack([yg,xg],axis=-1))\\n    correlation=float(np.corrcoef(out[4].ravel(),gp.ravel())[0,1])\\n    verification={'representative_wsa':'raw/wsa_202511280014R000_gong_z.fits',\\n                  'representative_gong':'raw/mrzqs251128t0014c2305_327.fits.gz',\\n                  'photospheric_field_pixel_correlation_after_regridding':correlation,\\n                  'latitude_formula':'latitude[j] = -89 + 2*j degrees; j = 0,...,89',\\n                  'longitude_formula':'CarringtonLongitude[i] = (CARRLONG + 1 + 2*i) modulo 360 degrees; i = 0,...,179',\\n                  'gong_wcs':'CRPIX1=180.5, CRVAL1=147, CDELT1=1; CRPIX2=90.5, CDELT2=1/90 in sine latitude',\\n                  'latest_earth_location':'For this GONG map, OBSLON=26.63, CARRLONG=327; Earth lies59.63deg from left edge. Generic WSA DU center180deg documentation does not describe this specific map.',\\n                  'density':'No density is supplied by WSA velocity maps. It requires a separate stated closure/calibration.',\\n                  'speed':'Empirical WSA speed already at21.5Rs. ENLIL can reduce it further using vrfast/vrslow parameters; raw WSA maps are not proven byte-identical to inaccessible run bnd.nc.',\\n                  'magnetic_field':'Array0 Br is nT at21.5Rs; no inverse-square rescaling unless boundary radius differs. ENLIL bscl=4 is a separate run setting.',\\n                  'radial_coordinate':'21.5 nominal solar radii=0.099985 AU using R_sun=695700km and AU=149597870.7km.'}\\n    (BASE/'boundary_manifest.json').write_text(json.dumps({'arrays':{'br_nT':'map,latitude,longitude','speed_kms':'map,latitude,longitude'},'maps':metadata,'verification':verification},indent=2))\\n    (BASE/'coordinate_verification.json').write_text(json.dumps(verification,indent=2))\\n    import matplotlib\\n    matplotlib.use('Agg')\\n    import matplotlib.pyplot as plt\\n    fig,axs=plt.subplots(1,3,figsize=(12,3.8),constrained_layout=True)\\n    vm=maps[[m['OBSTIME'].startswith('2025:11:28') for m in metadata]][0]\\n    for ax,img,title,unit,cmap,lims in zip(axs,[gp,vm[1],vm[0]],\\n        ['GONG photospheric radial field','WSA5.4 speed at21.5Rsun','WSA5.4 radial field at21.5Rsun'],\\n        ['G','km/s','nT'],['RdBu_r','viridis','RdBu_r'],[(-50,50),(280,860),(-150,150)]):\\n        c=ax.imshow(img,origin='lower',extent=[0,360,-90,90],aspect='auto',cmap=cmap,vmin=lims[0],vmax=lims[1])\\n        ax.set(xlabel='Longitude relative to map left edge (deg)',ylabel='Heliographic latitude (deg)',title=title)\\n        fig.colorbar(c,ax=ax,label=unit,orientation='horizontal',pad=.25)\\n    fig.suptitle('Observed map epoch2025-11-28T00:14 UTC; leading Carrington longitude327deg')\\n    fig.savefig(BASE/'boundary_diagnostic.png',dpi=150);plt.close(fig)\\n    print(json.dumps({'maps':len(maps),'orientation_correlation':correlation,\\n                      'ccmc_pn_cme_vs_ambient':summary['pn_cme_ambient_comparison']},indent=2))\\n\\nif __name__=='__main__': main()\\n{\\\"steps\\\":10820,\\\"rejected_steps\\\":543,\\\"first_order_fallback_steps\\\":543,\\\"minimum_dt_day\\\":0.0020502456413,\\\"wall_seconds\\\":387.712964801,\\\"mean_dimensionless_divB\\\":0.037802531612,\\\"max_dimensionless_divB\\\":3.04041036892,\\\"weighted_dimensionless_divB\\\":0.0265112739896,\\\"estimated_allocated_MB\\\":47.13216}\\n\"}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"f1aa9c\",\"wall_time_seconds\":0.000008351,\"exit_code\":0,\"original_token_count\":1896,\"output\":\"    fig.suptitle(\\\"Native spacecraft validation: no Parker remapping or time-shift fitting\\\",fontsize=13)\\n    fig.savefig(output/\\\"inhouse_native.png\\\",dpi=170)\\n    fig.savefig(output/\\\"inhouse_native.pdf\\\")\\n    plt.close(fig)\\n\\n\\ndef main():\\n    parser=argparse.ArgumentParser()\\n    parser.add_argument(\\\"--cases\\\",nargs=\\\"+\\\",default=[\\\"medium\\\",\\\"coarse\\\",\\\"fine\\\"])\\n    parser.add_argument(\\\"--output-dir\\\",type=Path,default=ROOT/\\\"validation\\\")\\n    parser.add_argument(\\\"--no-plot\\\",action=\\\"store_true\\\")\\n    parser.add_argument(\\\"--wait-for-case\\\",help=\\\"Wait for this run's statistics.json before validating; poll every15s\\\")\\n    parser.add_argument(\\\"--wait-timeout-seconds\\\",type=float,default=3600)\\n    args=parser.parse_args()\\n    if args.wait_for_case:\\n        deadline=time.monotonic()+args.wait_timeout_seconds\\n        marker=ROOT/f\\\"results/{args.wait_for_case}/statistics.json\\\"\\n        print(\\\"Waiting for\\\",marker,flush=True)\\n        while not marker.exists():\\n            if time.monotonic()>deadline:\\n                raise SystemExit(\\\"Timed out waiting for completed run: \\\"+args.wait_for_case)\\n            time.sleep(15)\\n    metadata=json.loads((ROOT/\\\"inputs/metadata.json\\\").read_text())\\n    origin=float(metadata[\\\"origin_mjd_utc\\\"])\\n    requested_start,requested_stop=Time([\\\"2025-11-25T00:00:00\\\",\\\"2025-12-06T00:00:00\\\"],format=\\\"isot\\\",scale=\\\"utc\\\").mjd\\n    training_stop=Time(metadata[\\\"calibration_interval_utc\\\"][1],format=\\\"isot\\\",scale=\\\"utc\\\").mjd\\n    assert requested_start>=training_stop,\\\"Validation would overlap normalization training\\\"\\n    ccmc=np.load(ROOT/\\\"external_model/ccmc_profiles.npz\\\")\\n    probes={case:load_probes(ROOT/f\\\"results/{case}/probe.csv\\\",origin) for case in args.cases if (ROOT/f\\\"results/{case}/statistics.json\\\").exists()}\\n    probes={k:v for k,v in probes.items() if v}\\n    if not probes:\\n        raise SystemExit(\\\"No populated probe.csv available yet; run simulations first.\\\")\\n    report={\\\"requested_interval_start_utc\\\":\\\"2025-11-25T00:00:00\\\", \\\"requested_stop_exclusive_utc\\\":\\\"2025-12-06T00:00:00\\\", \\\"actual_coverage\\\":\\\"Per instrument/case coverage below; no extrapolation outside completed probe times.\\\", \\\"normalization_metadata\\\":metadata, \\\"validation_training_separation\\\":\\\"All native paired samples at or after the exclusive normalization training stop. Wind is entirely absent from normalization training.\\\", \\\"frame\\\":\\\"Native spacecraft positions; no corotation or radial propagation applied to observations.\\\", \\\"cadence\\\":\\\"Model native hourly means: COHO [timestamp,timestamp+1h]; OMNI [timestamp-0.5h,timestamp+0.5h], 1-minute trapezoid quadrature. In-house probe series interpolated between hourly outputs; CCMC between native approximately3.6-minute output.\\\", \\\"caveats\\\":[\\\"Hourly in-house probe cadence smooths unresolved subhour variability.\\\",\\\"STEREO-A/Solar Orbiter post-training samples provide temporal validation, while Wind supplies independent-instrument validation.\\\",\\\"The boundary solar maps are retrospective; this is a hindcast and not an operational forecast.\\\",\\\"Results are not calibrated to the comet or to CCMC output; residual errors constrain representativeness of the solar-wind estimate.\\\"],\\\"cases\\\":{}}\\n    records=[]\\n    for case,by_monitor in probes.items():\\n        report[\\\"cases\\\"][case]={}\\n        for monitor,(number,target) in MONITORS.items():\\n            if monitor not in by_monitor:continue\\n            obsrows=list(csv.DictReader((HERE/f\\\"plasma_{monitor}.tsv\\\").open(),delimiter=\\\"\\\\t\\\"))\\n            obsrows=[r for r in obsrows if requested_start<=float(r[\\\"mjd_utc\\\"])<requested_stop]\\n            stamps=np.array([float(r[\\\"mjd_utc\\\"]) for r in obsrows])\\n            obs={field:np.array([float(r[spec[0]]) for r in obsrows]) for field,spec in FIELDS.items()}\\n            model=by_monitor[monitor]\\n            own={field:average_at_native(stamps,monitor,model[\\\"mjd\\\"],model[field]) for field in FIELDS}\\n            others={}\\n            for version,desc in [(\\\"1\\\",\\\"cme\\\"),(\\\"2amb\\\",\\\"ambient\\\")]:\\n                track=ccmc[target+version]\\n                others[desc]={field:average_at_native(stamps,monitor,track[:,0],track[:,spec[2]]) for field,spec in FIELDS.items()}\\n            paired=np.ones(len(stamps),dtype=bool)\\n            for field in FIELDS:paired &= np.isfinite(own[field]) & np.isfinite(others[\\\"ambient\\\"][field]) & np.isfinite(others[\\\"cme\\\"][field])\\n            result={\\\"samples\\\":int(paired.sum()), \\\"discarded_outside_model_coverage_or_missing\\\":int((~paired).sum())}\\n            if np.any(paired):\\n                result.update(first_paired_utc=Time(stamps[paired].min(),format=\\\"mjd\\\").isot,last_paired_utc=Time(stamps[paired].max(),format=\\\"mjd\\\").isot)\\n            result[\\\"inhouse\\\"]={field:metric(obs[field][paired],own[field][paired]) for field in FIELDS}\\n            result[\\\"ccmc_ambient\\\"]={field:metric(obs[field][paired],others[\\\"ambient\\\"][field][paired]) for field in FIELDS}\\n            result[\\\"ccmc_cme\\\"]={field:metric(obs[field][paired],others[\\\"cme\\\"][field][paired]) for field in FIELDS}\\n            report[\\\"cases\\\"][case][monitor]=result\\n            for k,t in enumerate(stamps):\\n                if not paired[k]:continue\\n                row={\\\"case\\\":case,\\\"monitor\\\":monitor,\\\"mjd_utc\\\":t,\\\"utc\\\":Time(t,format=\\\"mjd\\\").isot}\\n                for field in FIELDS:\\n                    row.update({\\\"observed_\\\"+field:obs[field][k],\\\"inhouse_\\\"+field:own[field][k],\\\"ccmc_ambient_\\\"+field:others[\\\"ambient\\\"][field][k],\\\"ccmc_cme_\\\"+field:others[\\\"cme\\\"][field][k]})\\n                records.append(row)\\n    args.output_dir.mkdir(exist_ok=True,parents=True)\\n    if not records:\\n        raise SystemExit(\\\"Probe files exist but no complete post-training native hour is covered yet.\\\")\\n    (args.output_dir/\\\"inhouse_native.json\\\").write_text(json.dumps(report,indent=2,allow_nan=False)+\\\"\\\\n\\\")\\n    with (args.output_dir/\\\"inhouse_native.tsv\\\").open(\\\"w\\\",newline=\\\"\\\") as f:\\n        w=csv.DictWriter(f,list(records[0]),delimiter=\\\"\\\\t\\\");w.writeheader();w.writerows(records)\\n    if not args.no_plot:\\n        make_plot(records,\\\"medium\\\" if \\\"medium\\\" in probes else next(iter(probes)),args.output_dir)\\n    print(json.dumps({case:{name:{\\\"samples\\\":d[\\\"samples\\\"],\\\"flux_median_model_over_obs\\\":d[\\\"inhouse\\\"][\\\"flux_cm2_s\\\"].get(\\\"median_model_over_observed\\\"),\\\"flux_r\\\":d[\\\"inhouse\\\"][\\\"flux_cm2_s\\\"].get(\\\"pearson_r\\\")} for name,d in content.items()} for case,content in report[\\\"cases\\\"].items()},indent=2))\\n\\n\\nif __name__==\\\"__main__\\\":main()\\n{\\n  \\\"case\\\": \\\"medium\\\",\\n  \\\"frames\\\": 41,\\n  \\\"start_utc\\\": \\\"2025-11-25T00:00:00.000\\\",\\n  \\\"end_utc\\\": \\\"2025-12-05T00:00:00.000\\\",\\n  \\\"flux_definition\\\": \\\"np|vSW|*(r/AU)^2, radius-normalized contrast only\\\",\\n  \\\"units\\\": \\\"cm^-2 s^-1\\\",\\n  \\\"colormap_range\\\": [\\n    100000000.0,\\n    800000000.0\\n  ],\\n  \\\"slice\\\": \\\"fixed J2000 ecliptic z=0; exact 3D interpolation in solar-equatorial mesh\\\",\\n  \\\"markers\\\": \\\"planet and spacecraft positions projected to ecliptic plane\\\",\\n  \\\"planet_ephemerides\\\": \\\"Astropy builtin solar-system ephemeris, Sun centered; spacecraft and comet JPL Horizons geometric vectors\\\",\\n  \\\"snapshots_are_simulation_data\\\": true\\n}\\nnr=72\\nntheta=12\\nnphi=72\\nrmin_au=0.0999850461106864\\nrmax_au=2.3\\nlatmax_deg=60\\nradial_grid=uniform\\ngamma=1.5\\nthermal_pressure_factor=2\\ncfl=0.35\\norder=2\\nthreads=2\\nstart_day=9\\nend_day=34\\noutput_start_day=24\\nsnapshot_days=0.25\\nboundary_map_csv=/mnt/c/Users/cabot/OneDrive/Documents/Research/Cambridge/X3I/mhd_llm/codex/inputs/boundary_map.csv\\nprobes_csv=/mnt/c/Users/cabot/OneDrive/Documents/Research/Cambridge/X3I/mhd_llm/codex/inputs/probes.csv\\nmap_rotation_rad_day=0.24756448241988369\\nmap_epoch_day=0\\nmap_longitude_offset_rad=-1.0502672621698068\\noutput_dir=/mnt/c/Users/cabot/OneDrive/Documents/Research/Cambridge/X3I/mhd_llm/codex/results/wide_movie\\n\"}}\n{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"1af5eb\",\"wall_time_seconds\":0.000013594,\"exit_code\":0,\"original_token_count\":1337,\"output\":\"# Three-dimensional finite-volume solar-wind solver\\n\\nBuild with `make -C solver` from the project directory; run\\n`solver/mhd_solver --config path/to/run.cfg`. Only the C++17 standard library\\nand optional OpenMP are needed. `python solver/verify.py` runs the small tests\\nand records numerical evidence in `solver/tests/verification.json`.\\n\\n## Equations and geometry\\n\\nThis is a genuinely three-dimensional, compressible ideal-MHD calculation:\\nall three momentum and magnetic components are transported across radial,\\nlatitudinal, and longitudinal faces. The evolved vectors use a fixed Cartesian\\nbasis. Each spherical control volume has its exact volume and analytically\\nintegrated outward face area vectors. Cartesian conservation therefore handles\\ngeometric momentum and magnetic transport without coordinate source terms.\\nCurved-face fluxes are evaluated using the direction and magnitude of their\\nintegrated area vector. This is a consistent quadrature approximation which\\nmust be tested under angular refinement. In particular, constant Cartesian\\npressure, velocity, and magnetic field have a zero flux divergence to machine\\nprecision because each cell's area vectors sum to zero.\\n\\nThe flux is local Lax-Friedrichs (Rusanov), with primitive-variable MC-limited\\nMUSCL reconstruction and two-stage SSP Runge-Kutta integration. `order=1`\\ndisables reconstruction. The radial coordinate may be uniform or logarithmic.\\nThe fixed wedge avoids the polar coordinate singularity. Longitude is periodic;\\nlatitude has open boundaries with extrapolated **spherical** components;\\nthe outer radial boundary extrapolates outward. The supersonic inner face is\\nprescribed directly by the boundary model. Latitude boundaries can affect\\nsolutions near the wedge edges; there is no polar cap or full-sphere closure.\\n\\nAn extended-energy GLM system transports magnetic divergence at the global\\nfast-wave speed and exponentially damps its scalar field. If `q=psi/c_h`,\\nthe total energy includes `q²/2`, the magnetic flux includes `c_h q n`, the\\nq flux is `c_h B.n`, and the energy flux includes `c_h q B.n`. Damping removes\\nthe corresponding q energy, preserving thermal pressure. No constrained\\ntransport is used and discrete divergence does not vanish identically.\\nDiagnostics use centered face magnetic fields, rather than an independent\\nstaggered representation. The reported quantity `h|div B|/|B|`, with\\n`h=volume^(1/3)`, can be large near a magnetic null. The additional\\n`weighted_dimensionless_divB = integral(h|div B|)/integral(|B|)` avoids that\\npointwise singularity. Both measures require scrutiny under refinement.\\n\\nDensity and thermal pressure must remain positive. No density or pressure\\nfloors are imposed. If a second-order step fails positivity, that step is\\nretried at first spatial order and explicitly counted; a first-order failure\\ncauses timestep halving, and ten unsuccessful halvings cause a hard error.\\n`statistics.json` records both rejected attempts and successful first-order\\nfallbacks. A run requiring frequent fallbacks is not evidence of convergence.\\n\\nThe default single-fluid gamma is 1.5. `temperature_K` is interpreted as the\\nproton temperature at the inner boundary, with `p=2 n_p k_B T` (equal proton\\nand electron temperatures). `thermal_pressure_factor` changes that factor.\\nGravity is included with `GM_sun=0.0002959122082855911 AU³/day²`; setting\\n`gravity_gm=0` disables it. There is no explicit coronal heating, resistivity,\\nviscosity, charge-state evolution, neutral gas, or charge-exchange emission.\\nThe effective gamma and inner pressure therefore remain physical modeling\\nassumptions, and proton flux alone does not determine heavy-ion flux.\\n\\nInternal units are AU, day, density `m_p cm^-3`, with magnetic permeability\\nset to one. Outputs use the physical units named in their column headers.\\n\\n## Configuration and boundary data\\n\\nAll paths are interpreted relative to the command's current working directory.\\nComments start with `#` and configuration consists of `key=value` lines.\\n\\n```ini\\nnr=64\\nntheta=8\\nnphi=48\\nrmin_au=0.1\\nrmax_au=2.4\\nlatmax_deg=60\\nradial_grid=uniform\\ngamma=1.5\\ncfl=0.35\\norder=2\\nthreads=2\\nstart_day=9\\nend_day=34\\noutput_start_day=20\\nsnapshot_days=0.5\\noutput_dir=outputs/example\\nboundary_map_csv=inputs/boundary_map.csv\\nmap_rotation_rad_day=0.247572\\nmhd_llm/codex/solver/diagnostics/medium_split_glm_divergence.json\\nmhd_llm/codex/solver/diagnostics/medium_split_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/medium_divergence.json\\nmhd_llm/codex/solver/diagnostics/coarse_split_glm_divergence.json\\nmhd_llm/codex/solver/diagnostics/coarse_split_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/coarse_glm_divergence.json\\nmhd_llm/codex/solver/diagnostics/coarse_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/coarse_divergence.json\\nmhd_llm/codex/solver/diagnostics/numerical_flux_comparison.png\\nmhd_llm/codex/solver/diagnostics/numerical_flux_comparison.pdf\\nmhd_llm/codex/solver/diagnostics/medium_split_glm_vs_medium_comparison.json\\nmhd_llm/codex/solver/diagnostics/medium_split_glm_vs_coarse_split_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/pilot24_wide_baseline_comparison.json\\nmhd_llm/codex/solver/diagnostics/pilot24_split_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/pilot24_wide_split_glm_comparison.json\\nmhd_llm/codex/solver/diagnostics/wide_coarse_divergence.json\\n\"}}","source_line":538,"directed_to":[],"call_id":"call_4f31d54